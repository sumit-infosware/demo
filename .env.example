NODE_ENV=development
PORT=4040
DATABASE_URL=postgresql://postgres:password@localhost:5432/database_name
REDIS_URL=redis://localhost:6379

# External IFS MySQL — READ-ONLY. SITS never writes to IFS.
IFS_DATABASE_URL=mysql://root:root@localhost:3306/ifs_demo
IFS_POLLING_ENABLED=true
JWT_ISSUER=my-secure-backend
JWT_AUDIENCE=my-secure-backend-api
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging — pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Security
BCRYPT_SALT_ROUNDS=12
CSRF_HEADER_NAME=x-requested-with
PUBLIC_PATHS=/health,/api/v1/auth/login,/api/v1/auth/register,/api/v1/auth/refresh,/api/docs
